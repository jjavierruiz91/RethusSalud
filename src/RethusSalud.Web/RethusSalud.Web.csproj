<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\RethusSalud.Application\RethusSalud.Application.csproj" />
    <ProjectReference Include="..\RethusSalud.Infrastructure\RethusSalud.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>770c560c-e585-40fa-981d-8d4e083051b6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- El SDK excluye "index.html" del publish por defecto; se incluye explicitamente
         para que la pagina de mantenimiento viaje siempre con el sitio. -->
    <Content Include="Mantenimiento\index.html" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
