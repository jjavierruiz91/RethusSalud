        </span>
        <span>Inicio</span>
    </a>
    <a class="app-bottom-nav-item @(currentController == "Consulta" ? "active" : "")" asp-area="" asp-controller="Consulta" asp-action="Index">
        <span class="app-bottom-nav-icon">
            <svg viewBox="0 0 24 24" fill="none"><circle cx="11" cy="11" r="6.5" stroke="currentColor" stroke-width="1.8"/><path d="m20 20-4.3-4.3" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
        </span>
        <span>Consultar</span>
