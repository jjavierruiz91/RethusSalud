<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0b3c66" />
    <link rel="manifest" href="~/manifest.json" />
    <link rel="apple-touch-icon" href="~/img/icons/apple-touch-icon.png" />
    <title>@ViewData["Title"] - Rethus</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RethusSalud.Web.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var brandController = "Home";
        var brandAction = "Index";
        if (User.Identity?.IsAuthenticated == true && !User.IsInRole(RethusSalud.Domain.Constants.Roles.Ciudadano))
        {
            if (User.IsInRole(RethusSalud.Domain.Constants.Roles.SuperAdmin))
            {
                brandController = "Admin";
                brandAction = "Usuarios";
            }
            else if (User.IsInRole(RethusSalud.Domain.Constants.Roles.FuncionarioEtapa1)
                || User.IsInRole(RethusSalud.Domain.Constants.Roles.FuncionarioEtapa2)
                || User.IsInRole(RethusSalud.Domain.Constants.Roles.FuncionarioEtapa3)
                || User.IsInRole(RethusSalud.Domain.Constants.Roles.Inventario))
            {
                brandController = "Revision";
                brandAction = "Bandeja";
            }
        }
    }
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white sticky-top site-navbar">
            <div class="container-fluid">
                <a class="navbar-brand site-navbar-brand" asp-area="" asp-controller="@brandController" asp-action="@brandAction">
                    <span class="site-navbar-mark">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 2 4 5v6c0 5 3.4 8.7 8 10 4.6-1.3 8-5 8-10V5l-8-3z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="m8.5 12 2.3 2.3L15.5 9.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    <span>Rethus</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        @if (User.Identity?.IsAuthenticated != true || User.IsInRole(RethusSalud.Domain.Constants.Roles.Ciudadano))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Index">Inicio</a>
                            </li>
                        }
                        @if (User.IsInRole(RethusSalud.Domain.Constants.Roles.SuperAdmin))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Admin" ? "active" : "")" asp-area="" asp-controller="Admin" asp-action="Usuarios">Administrar usuarios</a>
                            </li>
                        }
                        else if (User.IsInRole(RethusSalud.Domain.Constants.Roles.Ciudadano))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Tramite" ? "active" : "")" asp-area="" asp-controller="Tramite" asp-action="Dashboard">Mi tramite</a>
                            </li>
                        }
                        else if (User.IsInRole(RethusSalud.Domain.Constants.Roles.FuncionarioEtapa1)
                            || User.IsInRole(RethusSalud.Domain.Constants.Roles.FuncionarioEtapa2)
                            || User.IsInRole(RethusSalud.Domain.Constants.Roles.FuncionarioEtapa3)
                            || User.IsInRole(RethusSalud.Domain.Constants.Roles.Inventario))
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Revision" ? "active" : "")" asp-area="" asp-controller="Revision" asp-action="Bandeja">Bandeja de revision</a>
                            </li>
                        }
                        else if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Panel" ? "active" : "")" asp-area="" asp-controller="Home" asp-action="Panel">Mi perfil</a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-sm-center">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item d-flex align-items-center me-3">
                                <span class="site-navbar-user">@User.Identity!.Name</span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post">
                                    <button type="submit" class="btn btn-link nav-link site-navbar-logout">Cerrar sesion</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="btn-navbar-outline" asp-controller="Account" asp-action="Login">Iniciar sesión</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer @(currentController == "Tramite" || currentController == "Consulta" ? "site-footer--tramite" : "")">
        <div class="container">
            <div class="row g-4 site-footer-top">
                <div class="col-lg-4">
                    <a class="site-footer-brand" asp-area="" asp-controller="Home" asp-action="Index">Rethus</a>
                    <p class="site-footer-text">
                        Registro Único Nacional del Talento Humano en Salud. Un servicio de la Secretaría de
                        Salud Departamental del Cesar para el trámite y consulta del certificado Rethus.
                    </p>
                </div>
                <div class="col-lg-4 col-sm-6">
                    <h3 class="site-footer-heading">Enlaces útiles</h3>
                    <ul class="site-footer-links">
                        <li><a asp-controller="Home" asp-action="Index">Inicio</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="sobre-nosotros">Sobre nosotros</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="proceso">Nuestro proceso</a></li>
                        <li><a asp-controller="Home" asp-action="Index" asp-fragment="preguntas-frecuentes">Preguntas frecuentes</a></li>
                        <li><a asp-controller="Consulta" asp-action="Index">Consultar trámite</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-sm-6">
                    <h3 class="site-footer-heading">Contacto</h3>
                    <ul class="site-footer-contact">
                        <li>
                            <svg viewBox="0 0 24 24" fill="none"><path d="M12 21s7-6.5 7-12a7 7 0 1 0-14 0c0 5.5 7 12 7 12z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><circle cx="12" cy="9" r="2.5" stroke="currentColor" stroke-width="1.8"/></svg>
                            <span>Calle 16 # 12-120, Edificio Alfonso López Michelsen</span>
                        </li>
                        <li>
                            <svg viewBox="0 0 24 24" fill="none"><path d="M4 5c0-.6.4-1 1-1h3l2 5-2 1.5a10 10 0 0 0 5 5L14.5 14l5 2v3c0 .6-.4 1-1 1C10.6 20 4 13.4 4 5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                            <a href="tel:+576055885602">605 5885602</a>
                        </li>
                        <li>
                            <svg viewBox="0 0 24 24" fill="none"><rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.8"/><path d="m4 6.5 8 6 8-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            <a href="mailto:contactenos@cesar.gov.co">contactenos@cesar.gov.co</a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="site-footer-bottom">
            <div class="container">
                <div>&copy; 2026 Secretaría de Salud Departamental del Cesar &mdash; Rethus. Todos los derechos reservados.</div>
                <div class="site-footer-credito">
                    <div class="site-footer-credito-text">
                        <svg viewBox="0 0 24 24" fill="none"><path d="m8 8-4 4 4 4M16 8l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Desarrollado por <span class="credito-nombre">Ing. Javier Ruiz Mendoza</span>
                    </div>
                    <div class="credito-icons">
                        <a href="https://www.linkedin.com/in/javier-ruiz-mendoza-648129195/" target="_blank" rel="noopener" class="credito-icon li" aria-label="LinkedIn" title="Ver perfil de LinkedIn">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.94v5.666H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.114 20.452H3.558V9h3.556v11.452z"/></svg>
                        </a>
                        <a href="https://wa.me/573162937720?text=Hola%20Ing.%20Javier%20Ruiz%2C%20vi%20tu%20perfil%20en%20Rethus%20y%20me%20gustar%C3%ADa%20contactarte%20para%20un%20proyecto." target="_blank" rel="noopener" class="credito-icon wa" aria-label="WhatsApp" title="Escríbeme por WhatsApp">
                            <svg viewBox="0 0 16 16" fill="currentColor"><path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.1-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.336-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/></svg>
                        </a>
                        <a href="https://github.com/jjavierruiz91" target="_blank" rel="noopener" class="credito-icon gh" aria-label="GitHub" title="Ver perfil de GitHub">
                            <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </footer>

    @if (User.Identity?.IsAuthenticated == true && User.IsInRole(RethusSalud.Domain.Constants.Roles.Ciudadano) && currentController != "Tramite")
    {
        @await Html.PartialAsync("_CiudadanoBottomNav")
        @await Html.PartialAsync("_MiPerfilModal")
    }
    else if (User.IsInRole(RethusSalud.Domain.Constants.Roles.SuperAdmin))
    {
        @await Html.PartialAsync("_SuperAdminBottomNav")
    }
    else if (User.IsInRole(RethusSalud.Domain.Constants.Roles.FuncionarioEtapa1)
        || User.IsInRole(RethusSalud.Domain.Constants.Roles.FuncionarioEtapa2)
        || User.IsInRole(RethusSalud.Domain.Constants.Roles.FuncionarioEtapa3)
        || User.IsInRole(RethusSalud.Domain.Constants.Roles.Inventario))
    {
        @await Html.PartialAsync("_FuncionarioBottomNav")
    }
    else if (User.Identity?.IsAuthenticated != true)
    {
        @await Html.PartialAsync("_VisitanteBottomNav")
    }

    <div class="site-loading-overlay" id="siteLoadingOverlay" aria-hidden="true">
        <div class="site-loading-badge">
            <span class="site-loading-ring"></span>
            <img src="~/img/institucional/escudo_cesar_2024.png" alt="Gobernación del Cesar" />
        </div>
        <p class="site-loading-text" id="siteLoadingText">Cargando...</p>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
