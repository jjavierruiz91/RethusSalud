@using Microsoft.AspNetCore.Identity
@using RethusSalud.Infrastructure.Identity
@inject UserManager<ApplicationUser> AppLayoutUserManager
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Rethus</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RethusSalud.Web.styles.css" asp-append-version="true" />
</head>
<body class="app-body">
    @{
        var navItems = new List<(string Icon, string Label, string Controller, string Action)>();
        var isCiudadano = User.IsInRole(RethusSalud.Domain.Constants.Roles.Ciudadano);
        var isSuperAdmin = User.IsInRole(RethusSalud.Domain.Constants.Roles.SuperAdmin);
        var isFuncionarioEtapa1 = User.IsInRole(RethusSalud.Domain.Constants.Roles.FuncionarioEtapa1);
        var isFuncionario = isFuncionarioEtapa1
            || User.IsInRole(RethusSalud.Domain.Constants.Roles.FuncionarioEtapa2)
            || User.IsInRole(RethusSalud.Domain.Constants.Roles.FuncionarioEtapa3)
            || User.IsInRole(RethusSalud.Domain.Constants.Roles.Inventario);

        if (isCiudadano)
        {
            navItems.Add(("home", "Inicio", "Home", "Index"));
            navItems.Add(("document", "Mi trámite", "Tramite", "Dashboard"));
        }
        else if (isSuperAdmin)
        {
            navItems.Add(("users", "Usuarios", "Admin", "Usuarios"));
            navItems.Add(("inbox", "Seguimiento de revisiones", "Admin", "SeguimientoBandeja"));
            navItems.Add(("document", "Configuración institucional", "Admin", "ConfiguracionInstitucional"));
        }
        else if (isFuncionario)
        {
            navItems.Add(("inbox", "Bandeja de revisión", "Revision", "Bandeja"));
            navItems.Add(("search", "Buscar solicitud", "Revision", "Buscar"));
        }
        else
        {
            navItems.Add(("home", "Inicio", "Home", "Index"));
        }

        var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
        var userName = User.Identity?.Name ?? string.Empty;
        var userInitial = userName.Length > 0 ? userName[0].ToString().ToUpperInvariant() : "?";
        var roleLabel = isSuperAdmin ? "Administrador"
            : isFuncionario ? "Funcionario"
            : isCiudadano ? "Ciudadano"
            : "Usuario";
        var currentAppUser = await AppLayoutUserManager.GetUserAsync(User);
        var miFotoUrl = currentAppUser?.FotoUrl;
    }

    <div class="app-shell" id="appShell">
        <div class="app-sidebar-backdrop" id="appSidebarBackdrop"></div>
        <aside class="app-sidebar" id="appSidebar">
            <div class="app-sidebar-brand">
                <img src="~/img/institucional/escudo_cesar_2024.png" alt="Escudo de la Gobernación del Cesar" class="app-sidebar-escudo" />
                <span class="app-sidebar-brand-text">Rethus</span>
                <span class="app-sidebar-institucional-label">Gobernación del Cesar</span>
            </div>

            <nav class="app-sidebar-nav">
                @foreach (var item in navItems)
                {
                    var isActive = currentController == item.Controller && (
                        currentAction == item.Action ||
                        (item.Action == "SeguimientoBandeja" && (currentAction == "ExportarSeguimientoExcel" || currentAction == "SeguimientoDetalle" || currentAction == "DescargarArchivoSeguimiento")));
                    <a class="app-nav-link @(isActive ? "active" : "")" asp-area="" asp-controller="@item.Controller" asp-action="@item.Action">
                        <span class="app-nav-icon">@Html.Raw(AppIcon(item.Icon))</span>
                        <span>@item.Label</span>
                    </a>
                }

                <div style="border-top: 1px solid var(--rethus-border); margin: 0.6rem 0.1rem 0.5rem; padding-top: 0.5rem;">
                    <button type="button" class="app-nav-link" data-bs-toggle="modal" data-bs-target="#miPasswordModal">
                        <span class="app-nav-icon">@Html.Raw(AppIcon("password"))</span>
                        <span>Cambiar contraseña</span>
                    </button>
                    <button type="button" class="app-nav-link" data-bs-toggle="modal" data-bs-target="#miPerfilModal">
                        <span class="app-nav-icon">@Html.Raw(AppIcon("profile"))</span>
                        <span>Mi perfil</span>
                    </button>
                    @if (isFuncionario)
                    {
                        <button type="button" class="app-nav-link" data-bs-toggle="modal" data-bs-target="#cargoFirmaModal">
                            <span class="app-nav-icon">@Html.Raw(AppIcon("cargo"))</span>
                            <span>Cargo y firma</span>
                        </button>
                    }
                </div>
            </nav>

            <div class="app-sidebar-footer">
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="app-nav-link app-nav-link-btn">
                        <span class="app-nav-icon">@Html.Raw(AppIcon("logout"))</span>
                        <span>Cerrar sesión</span>
                    </button>
                </form>
            </div>
        </aside>

        <div class="app-main">
            <header class="app-topbar">
                <div class="app-topbar-left">
                    <button type="button" class="app-sidebar-toggle" id="appSidebarToggle" aria-label="Abrir menu">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                    </button>
                    <span class="app-topbar-title">@ViewData["Title"]</span>
                </div>
                <div class="dropdown app-user-menu">
                    <button type="button" class="app-topbar-user" data-bs-toggle="dropdown" aria-expanded="false">
                        @if (!string.IsNullOrEmpty(miFotoUrl))
                        {
                            <img src="@miFotoUrl" alt="" class="app-avatar app-avatar-img" />
                        }
                        else
                        {
                            <span class="app-avatar">@userInitial</span>
                        }
                        <span class="app-topbar-user-info">
                            <strong>@userName</strong>
                            <small>@roleLabel</small>
                        </span>
                        <svg viewBox="0 0 24 24" fill="none" class="app-user-menu-chevron"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                    <div class="dropdown-menu dropdown-menu-end app-user-dropdown">
                        <div class="app-user-dropdown-header">
                            @if (!string.IsNullOrEmpty(miFotoUrl))
                            {
                                <img src="@miFotoUrl" alt="" class="app-avatar app-avatar-img" style="width:72px;height:72px" />
                            }
                            else
                            {
                                <span class="app-avatar" style="width:72px;height:72px;font-size:1.6rem">@userInitial</span>
                            }
                            <strong>@userName</strong>
                            <span class="app-badge app-badge-muted">@roleLabel</span>
                        </div>
                        <button type="button" class="app-user-dropdown-item" data-bs-toggle="modal" data-bs-target="#miPasswordModal">
                            <svg viewBox="0 0 24 24" fill="none"><circle cx="8" cy="15" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M11 12l9-9M17 6l3 3M14 9l2.5 2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                            Cambiar contraseña
                        </button>
                        <button type="button" class="app-user-dropdown-item" data-bs-toggle="modal" data-bs-target="#miPerfilModal">
                            <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M4 20c0-3.9 3.6-7 8-7s8 3.1 8 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                            Mi perfil
                        </button>
                        @if (isFuncionario)
                        {
                            <button type="button" class="app-user-dropdown-item" data-bs-toggle="modal" data-bs-target="#cargoFirmaModal">
                                <svg viewBox="0 0 24 24" fill="none"><path d="M4 20c0-3.9 3.6-7 8-7s8 3.1 8 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M8 4h8l-1 4H9l-1-4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                                Cargo y firma
                            </button>
                        }
                        @if (isFuncionarioEtapa1)
                        {
                            <a class="app-user-dropdown-item" asp-controller="Admin" asp-action="Usuarios">
                                @Html.Raw(AppIcon("users"))
                                Usuarios
                            </a>
                        }
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            <button type="submit" class="app-user-dropdown-item app-user-dropdown-item-danger">
                                <svg viewBox="0 0 24 24" fill="none"><path d="M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M16 8l4 4-4 4M20 12H9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                Cerrar sesión
                            </button>
                        </form>
                    </div>
                </div>
            </header>

            <main class="app-content">
                @if (TempData["Error"] is string errorGlobal)
                {
                    <div class="app-alert app-alert-danger" role="alert">
                        <span class="app-alert-icon">
                            <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 8v5M12 16h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        </span>
                        <div class="app-alert-body">
                            <strong class="app-alert-title">Ocurrió un problema</strong>
                            <p class="app-alert-message">@errorGlobal</p>
                        </div>
                        <button type="button" class="app-alert-close" data-dismiss-alert aria-label="Cerrar">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                        </button>
                    </div>
                }
                @RenderBody()
            </main>
        </div>
    </div>

    @if (TempData["Mensaje"] is string mensajeGlobal)
    {
        <div class="modal fade" id="successFeedbackModal" tabindex="-1" aria-hidden="true" data-autoclose="3000">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content app-feedback-modal">
                    <button type="button" class="btn-close position-absolute top-0 end-0 m-3" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    <div class="modal-body text-center py-4">
                        <div class="confirm-modal-icon confirm-modal-icon-success app-feedback-icon">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </div>
                        <h3 class="app-feedback-title">¡Listo!</h3>
                        <p class="mb-0 app-feedback-message">@mensajeGlobal</p>
                    </div>
                    <div class="app-feedback-progress"><span></span></div>
                </div>
            </div>
        </div>
    }

    <div class="modal fade app-account-modal" id="miPasswordModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-controller="Account" asp-action="CambiarMiPassword" method="post">
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <div class="modal-header">
                        <span class="app-account-modal-icon">
                            <svg viewBox="0 0 24 24" fill="none"><circle cx="8" cy="15" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M11 12l9-9M17 6l3 3M14 9l2.5 2.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </span>
                        <div class="app-account-modal-heading">
                            <h5 class="modal-title">Cambiar contraseña</h5>
                            <p class="app-account-modal-subtitle">Actualiza tus credenciales de acceso al sistema.</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="auth-field">
                            <label class="auth-label">Contraseña actual</label>
                            <div class="auth-password-wrapper">
                                <input name="PasswordActual" type="password" id="miPasswordActual" class="form-control auth-input" required />
                                <button type="button" class="auth-password-toggle" data-toggle-password="miPasswordActual" aria-label="Mostrar contraseña">
                                    <svg viewBox="0 0 24 24" fill="none"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/></svg>
                                </button>
                            </div>
                        </div>
                        <div class="auth-field">
                            <label class="auth-label">Nueva contraseña</label>
                            <div class="auth-password-wrapper">
                                <input name="NuevaPassword" type="password" id="miPasswordNueva" class="form-control auth-input" minlength="4" required />
                                <button type="button" class="auth-password-toggle" data-toggle-password="miPasswordNueva" aria-label="Mostrar contraseña">
                                    <svg viewBox="0 0 24 24" fill="none"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/></svg>
                                </button>
                            </div>
                        </div>
                        <div class="auth-field mb-0">
                            <label class="auth-label">Confirmar nueva contraseña</label>
                            <div class="auth-password-wrapper">
                                <input name="ConfirmarPassword" type="password" id="miPasswordConfirmar" class="form-control auth-input" minlength="4" required data-match-password="miPasswordNueva" />
                                <button type="button" class="auth-password-toggle" data-toggle-password="miPasswordConfirmar" aria-label="Mostrar contraseña">
                                    <svg viewBox="0 0 24 24" fill="none"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn auth-submit-btn">Actualizar contraseña</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade app-account-modal" id="miPerfilModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-controller="Account" asp-action="ActualizarMiPerfil" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                    <div class="modal-header">
                        <span class="app-account-modal-icon">
                            @if (!string.IsNullOrEmpty(miFotoUrl))
                            {
                                <img src="@miFotoUrl" alt="" style="width:100%;height:100%;object-fit:cover;border-radius:0.9rem" />
                            }
                            else
                            {
                                @userInitial
                            }
                        </span>
                        <div class="app-account-modal-heading">
                            <h5 class="modal-title">Mi perfil</h5>
                            <p class="app-account-modal-subtitle">Tu información personal usada en todo el sistema.</p>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        @if (isFuncionario || isSuperAdmin)
                        {
                            <div class="auth-field">
                                <label class="auth-label">Foto de perfil</label>
                                <div class="app-signature-upload">
                                    <div class="app-signature-preview app-photo-preview" id="fotoPreviewBox">
                                        @if (!string.IsNullOrEmpty(miFotoUrl))
                                        {
                                            <img src="@miFotoUrl" alt="Foto actual" />
                                        }
                                        else
                                        {
                                            <span class="app-signature-preview-empty">
                                                <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="8" r="4" stroke="currentColor" stroke-width="1.6"/><path d="M4 20c0-3.9 3.6-7 8-7s8 3.1 8 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                                            </span>
                                        }
                                    </div>
                                    <div class="app-signature-upload-body">
                                        <input name="Foto" type="file" accept="image/jpeg,image/png" data-signature-preview="fotoPreviewBox" />
                                        <div class="app-signature-upload-hint">JPG o PNG, máx. 5 MB</div>
                                    </div>
                                </div>
                            </div>
                        }
                        <div class="auth-field">
                            <label class="auth-label">Nombre completo</label>
                            <input name="NombreCompleto" class="form-control auth-input" value="@currentAppUser?.NombreCompleto" required />
                        </div>
                        <div class="auth-field">
                            <label class="auth-label">Número de identificación</label>
                            <input name="NumeroIdentificacion" class="form-control auth-input" value="@currentAppUser?.NumeroIdentificacion" placeholder="Ej. 1065xxxxxx" />
                        </div>
                        <div class="auth-field">
                            <label class="auth-label">Correo electrónico</label>
                            <input name="Email" type="email" class="form-control auth-input" value="@currentAppUser?.Email" required />
                            <div class="app-signature-upload-hint mt-1">El correo es también tu usuario para iniciar sesión.</div>
                        </div>
                        <div class="auth-field mb-0">
                            <label class="auth-label">Teléfono</label>
                            <input name="Telefono" type="tel" class="form-control auth-input" value="@currentAppUser?.Telefono" placeholder="Ej. 3001234567" />
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn auth-submit-btn">Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (isFuncionario)
    {
        <div class="modal fade app-account-modal" id="cargoFirmaModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form asp-controller="Account" asp-action="ActualizarMiFirma" method="post" enctype="multipart/form-data">
                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                        <div class="modal-header">
                            <span class="app-account-modal-icon">
                                <svg viewBox="0 0 24 24" fill="none"><path d="M4 20c0-3.9 3.6-7 8-7s8 3.1 8 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M8 4h8l-1 4H9l-1-4z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                            </span>
                            <div class="app-account-modal-heading">
                                <h5 class="modal-title">Cargo y firma</h5>
                                <p class="app-account-modal-subtitle">Se usa en el bloque de firmas de los documentos que generas o apruebas.</p>
                            </div>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                        </div>
                        <div class="modal-body">
                            <div class="auth-field">
                                <label class="auth-label">Cargo</label>
                                <textarea name="Cargo" class="form-control auth-input auth-textarea" rows="2" placeholder="Ej. Profesional universitario contratista secretaria de salud Departamental">@currentAppUser?.Cargo</textarea>
                            </div>
                            <div class="auth-field mb-0">
                                <label class="auth-label">Imagen de firma</label>
                                <div class="app-signature-upload">
                                    <div class="app-signature-preview" id="firmaPreviewBox">
                                        @if (!string.IsNullOrEmpty(currentAppUser?.FirmaUrl))
                                        {
                                            <img src="@currentAppUser.FirmaUrl" alt="Firma actual" />
                                        }
                                        else
                                        {
                                            <span class="app-signature-preview-empty">
                                                <svg viewBox="0 0 24 24" fill="none"><path d="M4 18c3-4 6 2 9-2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M6 9l9-4 3 3-9 4-3-3z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
                                            </span>
                                        }
                                    </div>
                                    <div class="app-signature-upload-body">
                                        <input name="Firma" type="file" accept="image/jpeg,image/png" data-signature-preview="firmaPreviewBox" />
                                        <div class="app-signature-upload-hint">JPG o PNG, máx. 5 MB</div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                            <button type="submit" class="btn auth-submit-btn">Guardar cambios</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    string AppIcon(string name) => name switch
    {
        "home" =>
            "<svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 11.5 12 4l8 7.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M6 10v9h12v-9\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>",
        "document" =>
            "<svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M7 3h7l4 4v14H7z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><path d=\"M14 3v4h4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/></svg>",
        "users" =>
            "<svg viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"9\" cy=\"8\" r=\"3\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><path d=\"M15 8.2c1.2.4 2 1.5 2 2.8s-.8 2.4-2 2.8M17.5 20c0-2.4-1.4-4.5-3.5-5.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>",
        "inbox" =>
            "<svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M4 12h4l2 3h4l2-3h4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/><path d=\"M4 12 5.5 5h13L20 12v7H4z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/></svg>",
        "logout" =>
            "<svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M9 4H5a1 1 0 0 0-1 1v14a1 1 0 0 0 1 1h4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><path d=\"M16 8l4 4-4 4M20 12H9\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>",
        "search" =>
