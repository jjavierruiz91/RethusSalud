@model RethusSalud.Web.Models.LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesion";
    Layout = "_AuthLayout";
}

<div class="auth-shell">
    <div class="auth-card-wrapper auth-card-wrapper--compact">
        @await Html.PartialAsync("_AuthAside")

        <div class="auth-form-panel">
            <div class="auth-form-inner">
                <span class="hero-eyebrow auth-eyebrow-dark auth-eyebrow--compact">Acceso seguro</span>
                <div class="auth-form-logo auth-form-logo--compact">
                    <img src="~/img/institucional/escudo_cesar_2024.png" alt="Escudo de la Gobernación del Cesar" />
                </div>
                <h2 class="auth-form-title">Bienvenido de nuevo</h2>
                <p class="auth-form-subtitle">Ingresa con tu correo y contraseña para continuar tu trámite.</p>

                <form asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    <div asp-validation-summary="ModelOnly" class="auth-validation-summary"></div>

                    <div class="auth-field">
                        <label asp-for="Email" class="auth-label">Correo electrónico</label>
                        <input asp-for="Email" class="form-control auth-input" autocomplete="username" placeholder="nombre@ejemplo.com" />
                        <span asp-validation-for="Email" class="auth-field-error"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="Password" class="auth-label">Contraseña</label>
                        <div class="auth-password-wrapper">
                            <input asp-for="Password" class="form-control auth-input" autocomplete="current-password" placeholder="Tu contraseña" id="loginPassword" />
                            <button type="button" class="auth-password-toggle" data-toggle-password="loginPassword" aria-label="Mostrar contraseña">
                                <svg viewBox="0 0 24 24" fill="none"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.6"/></svg>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="auth-field-error"></span>
                    </div>

                    <div class="auth-checkbox">
                        <input asp-for="RememberMe" class="form-check-input" id="rememberMe" />
                        <label asp-for="RememberMe" class="form-check-label" for="rememberMe">Mantener sesión iniciada en este dispositivo</label>
                    </div>

                    <button type="submit" class="btn auth-submit-btn w-100">Iniciar sesión</button>
                </form>

                <p class="auth-switch-text">
                    ¿No tienes cuenta? <a asp-controller="Account" asp-action="Register">Crear una cuenta</a>
                </p>
            </div>

            <div class="auth-form-footer auth-form-footer--compact">
                &copy; 2026 Secretaría de Salud Departamental del Cesar &mdash; Rethus.
                <a asp-controller="Home" asp-action="Privacy">Política de privacidad</a>
                <div class="auth-footer-credito">
                    <div class="auth-footer-credito-text">
                        <svg viewBox="0 0 24 24" fill="none"><path d="m8 8-4 4 4 4M16 8l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Desarrollado por <span class="credito-nombre">Ing. Javier Ruiz Mendoza</span>
                    </div>
                    <div class="credito-icons">
                        <a href="https://www.linkedin.com/in/javier-ruiz-mendoza-648129195/" target="_blank" rel="noopener" class="credito-icon li" aria-label="LinkedIn" title="Ver perfil de LinkedIn">
                            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.94v5.666H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 1 1 0-4.124 2.062 2.062 0 0 1 0 4.124zM7.114 20.452H3.558V9h3.556v11.452z"/></svg>
                        </a>
                        <a href="https://wa.me/573162937720?text=Hola%20Ing.%20Javier%20Ruiz%2C%20vi%20tu%20perfil%20en%20Rethus%20y%20me%20gustar%C3%ADa%20contactarte%20para%20un%20proyecto." target="_blank" rel="noopener" class="credito-icon wa" aria-label="WhatsApp" title="Escríbeme por WhatsApp">
                            <svg viewBox="0 0 16 16" fill="currentColor"><path d="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.1-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.336-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232"/></svg>
                        </a>
                        <a href="https://github.com/jjavierruiz91" target="_blank" rel="noopener" class="credito-icon gh" aria-label="GitHub" title="Ver perfil de GitHub">
                            <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
