@model RethusSalud.Web.Models.Tramite.SeleccionarTramiteViewModel
@{
    ViewData["Title"] = "Seleccionar tramite";
}

@await Html.PartialAsync("_TramiteSteps", new RethusSalud.Web.Models.Tramite.TramiteStepsViewModel { PasoActual = 1, PasoMaximo = (int)(ViewBag.PasoMaximo ?? 1), SolicitudId = (int?)ViewBag.SolicitudId })

<h1 class="text-center">Selecciona tu profesión u ocupación</h1>

<div class="app-panel mx-auto" style="max-width: 960px">
    <div class="text-center">
        <span class="hero-eyebrow auth-eyebrow-dark">Registro Rethus</span>
    </div>

    <ul class="profesion-list">
        @foreach (var profesion in Model.Profesiones)
        {
            <li class="profesion-item">
                <span>@profesion.Nombre</span>
                <form asp-action="SeleccionarTramite" method="post" class="m-0">
                    <input type="hidden" name="profesionId" value="@profesion.Id" />
                    <button type="submit" class="btn btn-sm btn-outline-primary">Realizar trámite</button>
                </form>
            </li>
        }
        @if (!Model.Profesiones.Any())
        {
            <li class="text-center text-muted py-3">No hay profesiones disponibles para este tipo de trámite.</li>
        }
    </ul>
</div>
