@model RethusSalud.Domain.Entities.Solicitud?
@using RethusSalud.Domain.Entities
@using RethusSalud.Domain.Enums
@using RethusSalud.Web.Helpers
@{
    ViewData["Title"] = "Mi tramite";
    Layout = "_AppLayout";
    var solicitante = (Solicitante)ViewBag.Solicitante;
}

<h1>Bienvenido, @solicitante.Nombres</h1>

<div class="card">
    <div class="card-body">
        <p><strong>Nombres:</strong><br />@solicitante.Nombres @solicitante.Apellidos</p>
        <p><strong>Correo electronico:</strong><br />@solicitante.CorreoElectronico</p>
        <p><strong>Tipo de tramite:</strong><br />@(Model is null ? "No se ha seleccionado un tipo de tramite" : Model.TipoTramite.ToString())</p>
        <p><strong>Estado de solicitud:</strong><br />
            @if (Model is null)
            {
                <span>Aun no has iniciado tu tramite.</span>
            }
            else if (Model.Estado == EstadoSolicitud.Borrador)
            {
                <span>Complete su proceso de tramite para ser enviados a los funcionarios para su revision y validacion.</span>
            }
            else if (Model.Estado == EstadoSolicitud.EnProceso)
            {
                <span>En proceso - Etapa actual: @Model.EtapaActual</span>
            }
            else if (Model.Estado == EstadoSolicitud.Rechazado)
            {
                <span>Rechazada</span>
            }
            else
            {
                <span>@EstadoDisplay.Texto(Model.Estado)</span>
            }
        </p>

        @if (Model is null)
        {
            <a class="btn btn-primary" asp-controller="Tramite" asp-action="Terminos">Comenzar tramite</a>
        }
        else if (Model.Estado == EstadoSolicitud.Borrador && Model.DatosAcademicos is not null)
        {
            <a class="btn btn-primary" asp-controller="Tramite" asp-action="Documentos" asp-route-solicitudId="@Model.Id">Continuar proceso de tramite</a>
        }
        else if (Model.Estado == EstadoSolicitud.Borrador)
        {
            <a class="btn btn-primary" asp-controller="Tramite" asp-action="DatosPersonales" asp-route-solicitudId="@Model.Id">Continuar proceso de tramite</a>
        }
        else if (Model.Estado == EstadoSolicitud.Rechazado)
        {
            <form asp-controller="Tramite" asp-action="Corregir" method="post">
                <input type="hidden" name="solicitudId" value="@Model.Id" />
                <button type="submit" class="btn btn-warning">Corregir y reenviar solicitud</button>
            </form>
        }
        else if (Model.Estado == EstadoSolicitud.Aprobado)
        {
            <a class="btn btn-success" asp-controller="Tramite" asp-action="DescargarCertificado" asp-route-solicitudId="@Model.Id">Descargar certificado</a>
        }
    </div>
</div>

@{
    var rechazos = Model?.Historial
        .Where(h => h.EstadoResultante == EstadoSolicitud.Rechazado)
        .OrderByDescending(h => h.Fecha)
        .ToList() ?? new List<HistorialEstado>();
}
@if (rechazos.Any())
{
    <div class="card mt-3">
        <div class="card-body">
            <h2 class="h5 mb-3">Historial de rechazos</h2>
            @foreach (var rechazo in rechazos)
            {
                <div class="app-alert app-alert-danger mb-2" role="alert">
                    <span class="app-alert-icon">
                        <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.8"/><path d="M12 8v5M12 16h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                    </span>
                    <div class="app-alert-body">
                        <strong class="app-alert-title">
                            @(rechazo.EtapaResultante.HasValue ? EtapaDisplay.Texto(rechazo.EtapaResultante.Value) : "Revision")
                            &middot; @rechazo.Fecha.ToLocalTime().ToString("dd MMM yyyy · hh:mm tt")
                        </strong>
                        <p class="app-alert-message mb-0">@rechazo.Motivo</p>
                    </div>
                </div>
            }
        </div>
    </div>
}
