@model RethusSalud.Web.Models.Admin.ConfiguracionInstitucionalViewModel
@{
    ViewData["Title"] = "Configuración institucional";
    Layout = "_AppLayout";

    string EtiquetaRol(string rol) => rol switch
    {
        "FuncionarioEtapa1" => "Etapa 1 · Proyectó",
        "FuncionarioEtapa2" => "Etapa 2 · Aprobó",
        "FuncionarioEtapa3" => "Etapa 3 · Revisó",
        "Inventario" => "Inventario · Generó / Consecutivo",
        _ => rol
    };
}

<div class="config-institucional-layout">
<div class="app-panel firma-toolbar-panel">
    <form asp-action="ConfiguracionInstitucional" method="post" enctype="multipart/form-data" class="firma-toolbar">
        <div class="firma-toolbar-title">
            <h2 class="config-panel-title mb-0">Firma institucional</h2>
            <span class="config-info-icon" tabindex="0" title="Esta firma aparece en todos los documentos generados (resoluciones), como la autoridad que expide el acto administrativo. No corresponde a ninguna etapa del flujo de revisión.">
                <svg viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.6"/><path d="M12 8h.01M11 11h1v5h1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
        </div>
        <div class="firma-toolbar-field">
            <label class="form-label small mb-1">Nombre completo</label>
            <input name="Nombre" class="form-control form-control-sm" value="@Model.Nombre" placeholder="Ej. Georgina Paola Sánchez Daza" required />
        </div>
        <div class="firma-toolbar-field">
            <label class="form-label small mb-1">Cargo</label>
            <input name="Cargo" class="form-control form-control-sm" value="@Model.Cargo" placeholder="Ej. Secretaria de Salud Departamento del Cesar" required />
        </div>
        <div class="firma-toolbar-field firma-toolbar-field--firma">
            <label class="form-label small mb-1">Firma</label>
            <div data-firma-input>
                <div class="firma-input-tabs">
                    <button type="button" class="firma-input-tab active" data-firma-tab="subir">Subir imagen</button>
                    <button type="button" class="firma-input-tab" data-firma-tab="dibujar">Dibujar firma</button>
                </div>
                <div data-firma-panel="subir" class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrEmpty(Model.FirmaUrl))
                    {
                        <img src="@Model.FirmaUrl" alt="Firma actual" class="firma-thumb firma-thumb--sm" />
                    }
                    else
                    {
                        <span class="text-muted small">Sin firma</span>
                    }
                    <input name="Firma" type="file" accept="image/jpeg,image/png" class="form-control form-control-sm" />
                </div>
                <div data-firma-panel="dibujar" class="d-none">
                    <canvas data-firma-canvas width="260" height="90" class="firma-input-canvas"></canvas>
                    <div class="firma-input-canvas-actions">
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-firma-clear>Limpiar</button>
                    </div>
                    <p class="firma-input-error d-none" data-firma-error>Dibuja una firma antes de continuar.</p>
                </div>
                <input type="hidden" name="FirmaDibujada" data-firma-hidden />
            </div>
        </div>
        <div class="firma-toolbar-action">
            <button type="submit" class="btn btn-sm auth-submit-btn">Guardar</button>
        </div>
    </form>
</div>

<div class="app-panel app-panel--compacta flex-fill">
    <h2 class="config-panel-title">Firmantes por etapa</h2>
    <p class="text-muted small mb-2">Nombre, cargo y firma de los funcionarios que aparecen en el bloque de firmas de cada documento generado.</p>

    <div class="table-responsive tabla-scroll d-none d-md-block">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th></th>
                    <th>Nombre</th>
                    <th>Etapa</th>
                    <th>Cargo</th>
                    <th>Correo</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var funcionario in Model.Funcionarios)
                {
                    <tr>
                        <td>
                            @if (!string.IsNullOrEmpty(funcionario.FirmaUrl))
                            {
                                <img src="@funcionario.FirmaUrl" alt="Firma de @funcionario.Nombre" class="firma-thumb firma-thumb--sm" />
                            }
                            else
                            {
                                <span class="app-badge app-badge-warning">Sin firma</span>
                            }
                        </td>
                        <td>@funcionario.Nombre</td>
                        <td><span class="app-badge app-badge-muted">@EtiquetaRol(funcionario.Rol)</span></td>
                        <td class="cargo-cell" title="@funcionario.Cargo">@(string.IsNullOrEmpty(funcionario.Cargo) ? "—" : funcionario.Cargo)</td>
                        <td><a href="mailto:@funcionario.Email">@funcionario.Email</a></td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editarFirmante-@funcionario.Id">Editar</button>
                        </td>
                    </tr>
                }
                @if (!Model.Funcionarios.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">No hay funcionarios asignados a etapas todavía.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mobile-card-list d-md-none">
        @foreach (var funcionario in Model.Funcionarios)
        {
            <div class="mobile-record-card">
                <div class="mobile-record-card-header">
                    @if (!string.IsNullOrEmpty(funcionario.FirmaUrl))
                    {
                        <img src="@funcionario.FirmaUrl" alt="Firma de @funcionario.Nombre" class="firma-thumb firma-thumb--sm" />
                    }
                    <span class="mobile-record-card-title">@funcionario.Nombre</span>
                    <span class="app-badge app-badge-muted">@EtiquetaRol(funcionario.Rol)</span>
                </div>
                @if (string.IsNullOrEmpty(funcionario.FirmaUrl))
                {
                    <div class="mobile-record-card-meta"><span class="app-badge app-badge-warning">Sin firma</span></div>
                }
                <div class="mobile-record-card-meta">@(string.IsNullOrEmpty(funcionario.Cargo) ? "Sin cargo asignado" : funcionario.Cargo)</div>
                <div class="mobile-record-card-meta mobile-record-card-meta--muted"><a href="mailto:@funcionario.Email">@funcionario.Email</a></div>
                <div class="mobile-record-card-actions">
                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editarFirmante-@funcionario.Id">Editar</button>
                </div>
            </div>
        }
        @if (!Model.Funcionarios.Any())
        {
            <p class="text-center text-muted mb-0">No hay funcionarios asignados a etapas todavía.</p>
        }
    </div>
</div>
</div>

@foreach (var funcionario in Model.Funcionarios)
{
    <div class="modal fade" id="editarFirmante-@funcionario.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <form asp-controller="Admin" asp-action="Editar" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="Id" value="@funcionario.Id" />
                    <input type="hidden" name="Email" value="@funcionario.Email" />
                    <input type="hidden" name="Rol" value="@funcionario.Rol" />
                    <input type="hidden" name="Origen" value="ConfiguracionInstitucional" />
                    <div class="modal-header">
                        <h5 class="modal-title">Editar firmante — @EtiquetaRol(funcionario.Rol)</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Nombre completo</label>
                            <input name="Nombre" class="form-control" value="@funcionario.Nombre" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Cargo</label>
                            <textarea name="Cargo" class="form-control" rows="2" placeholder="Ej. Asesor Jurídico secretaria de salud Departamental">@funcionario.Cargo</textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Imagen de firma</label>
                            <div data-firma-input>
                                <div class="firma-input-tabs">
                                    <button type="button" class="firma-input-tab active" data-firma-tab="subir">Subir imagen</button>
                                    <button type="button" class="firma-input-tab" data-firma-tab="dibujar">Dibujar firma</button>
                                </div>
                                <div data-firma-panel="subir">
                                    @if (!string.IsNullOrEmpty(funcionario.FirmaUrl))
                                    {
                                        <img src="@funcionario.FirmaUrl" alt="Firma actual" class="firma-thumb mb-2" />
                                    }
                                    <input name="Firma" type="file" accept="image/jpeg,image/png" class="form-control" />
                                </div>
                                <div data-firma-panel="dibujar" class="d-none">
                                    <canvas data-firma-canvas width="320" height="120" class="firma-input-canvas" style="max-width:320px;height:120px;"></canvas>
                                    <div class="firma-input-canvas-actions">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-firma-clear>Limpiar</button>
                                    </div>
                                    <p class="firma-input-error d-none" data-firma-error>Dibuja una firma antes de continuar.</p>
                                </div>
                                <input type="hidden" name="FirmaDibujada" data-firma-hidden />
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn auth-submit-btn">Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
