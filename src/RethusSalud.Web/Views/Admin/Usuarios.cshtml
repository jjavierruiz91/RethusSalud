@model List<RethusSalud.Web.Models.Admin.UsuarioInternoViewModel>
@{
    ViewData["Title"] = "Administracion de usuarios";
    Layout = "_AppLayout";
    var roles = (List<string>)ViewBag.Roles;
    var totalActivos = Model.Count(u => u.Activo);
    var totalInactivos = Model.Count(u => !u.Activo);
}

<div class="app-stat-row">
    <div class="app-stat-card app-stat-card--brand">
        <span class="app-stat-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><path d="M23 21v-2a4 4 0 0 0-3-3.87" /><path d="M16 3.13a4 4 0 0 1 0 7.75" /></svg>
        </span>
        <span class="app-stat-card-value">@Model.Count</span>
        <span class="app-stat-card-label">Total usuarios</span>
    </div>
    <div class="app-stat-card app-stat-card--success">
        <span class="app-stat-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="8.5" cy="7" r="4" /><path d="m17 11 2 2 4-4" /></svg>
        </span>
        <span class="app-stat-card-value">@totalActivos</span>
        <span class="app-stat-card-label">Activos</span>
    </div>
    <div class="app-stat-card app-stat-card--muted">
        <span class="app-stat-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" /><circle cx="8.5" cy="7" r="4" /><path d="m17 8 5 5" /><path d="m22 8-5 5" /></svg>
        </span>
        <span class="app-stat-card-value">@totalInactivos</span>
        <span class="app-stat-card-label">Inactivos</span>
    </div>
</div>

<div class="app-panel">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <form method="get" class="row g-2">
            <div class="col-auto">
                <input type="text" name="nombre" class="form-control" placeholder="Digite el nombre" value="@ViewBag.Nombre" />
            </div>
            <div class="col-auto">
                <select name="rol" class="form-select filter-role-select" onchange="this.form.submit()">
                    <option value="">Roles</option>
                    @foreach (var r in roles)
                    {
                        @if ((string?)ViewBag.Rol == r)
                        {
                            <option value="@r" selected>@r</option>
                        }
                        else
                        {
                            <option value="@r">@r</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Buscar</button>
                <a asp-action="Usuarios" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>
        <button type="button" class="btn auth-submit-btn" data-bs-toggle="modal" data-bs-target="#createUserModal">+ Crear usuario</button>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th></th>
                    <th>Nombre</th>
                    <th>Identificación</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model)
                {
                    <tr class="@(usuario.Activo ? "fila-verde" : "fila-inactiva")">
                        <td>
                            @if (!string.IsNullOrEmpty(usuario.FotoUrl))
                            {
                                <img src="@usuario.FotoUrl" alt="Foto de @usuario.Nombre" class="app-avatar app-avatar-img app-avatar-lg" />
                            }
                            else
                            {
                                <span class="app-avatar app-avatar-lg">@(usuario.Nombre.Length > 0 ? usuario.Nombre[0].ToString().ToUpperInvariant() : "?")</span>
                            }
                        </td>
                        <td>@usuario.Nombre</td>
                        <td>@usuario.Email</td>
                        <td>@usuario.Rol</td>
                        <td>@(usuario.Activo ? "Activo" : "Inactivo")</td>
                        <td class="text-end">
                            <div class="d-inline-flex gap-1">
                                <button type="button" class="icon-btn icon-btn-primary" data-bs-toggle="modal" data-bs-target="#editModal-@usuario.Id" title="Editar usuario">
                                    @Html.Raw(RowIcon("edit"))
                                </button>
                                <button type="button" class="icon-btn icon-btn-secondary" data-bs-toggle="modal" data-bs-target="#passwordModal-@usuario.Id" title="Cambiar contraseña">
                                    @Html.Raw(RowIcon("key"))
                                </button>
                                @if (usuario.Activo)
                                {
                                    <button type="button" class="icon-btn icon-btn-danger" data-bs-toggle="modal" data-bs-target="#confirmDeactivate-@usuario.Id" title="Desactivar usuario">
                                        @Html.Raw(RowIcon("power"))
                                    </button>
                                }
                                else
                                {
                                    <form asp-action="ToggleActivo" method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@usuario.Id" />
                                        <button type="submit" class="icon-btn icon-btn-success" title="Activar usuario">
                                            @Html.Raw(RowIcon("power"))
                                        </button>
                                    </form>
                                }
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted">Sin resultados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="createUserModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="Crear" method="post">
                <div class="modal-header">
                    <h5 class="modal-title">Crear usuario</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre</label>
                        <input name="Nombre" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Correo electrónico</label>
                        <input name="Email" type="email" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Rol</label>
                        <select name="Rol" class="form-select" required>
                            <option value="">Seleccionar</option>
                            @foreach (var r in roles)
                            {
                                <option value="@r">@r</option>
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Contraseña</label>
                        <div class="auth-password-wrapper">
                            <input name="Password" type="password" id="createPassword" class="form-control auth-input" minlength="4" required />
                            <button type="button" class="auth-password-toggle" data-toggle-password="createPassword" aria-label="Mostrar contraseña">
                                @Html.Raw(EyeIcon())
                            </button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn auth-submit-btn">Guardar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@foreach (var usuario in Model)
{
    <div class="modal fade" id="editModal-@usuario.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="Editar" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="Id" value="@usuario.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title">Editar usuario</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            @if (!string.IsNullOrEmpty(usuario.FotoUrl))
                            {
                                <img src="@usuario.FotoUrl" alt="" class="app-avatar app-avatar-img" style="width:56px;height:56px" />
                            }
                            else
                            {
                                <span class="app-avatar" style="width:56px;height:56px;font-size:1.2rem">@(usuario.Nombre.Length > 0 ? usuario.Nombre[0].ToString().ToUpperInvariant() : "?")</span>
                            }
                            <div class="flex-grow-1">
                                <label class="form-label mb-1">Foto (JPG o PNG)</label>
                                <input name="Foto" type="file" accept="image/jpeg,image/png" class="form-control form-control-sm" />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <input name="Nombre" class="form-control" value="@usuario.Nombre" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Correo electrónico</label>
                            <input name="Email" type="email" class="form-control" value="@usuario.Email" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Cargo</label>
                            <input name="Cargo" class="form-control" value="@usuario.Cargo" placeholder="Ej. Asesor Jurídico secretaria de salud Departamental" />
                        </div>
                        <div class="mb-3">
                            @if (!string.IsNullOrEmpty(usuario.FirmaUrl))
                            {
                                <img src="@usuario.FirmaUrl" alt="Firma actual" style="max-height:45px;border:1px solid var(--rethus-border);border-radius:0.4rem;padding:4px" class="mb-2 d-block" />
                            }
                            <label class="form-label">Imagen de firma (JPG o PNG)</label>
                            <input name="Firma" type="file" accept="image/jpeg,image/png" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Rol</label>
                            <select name="Rol" class="form-select" required>
                                @foreach (var r in roles)
                                {
                                    @if (usuario.Rol == r)
                                    {
                                        <option value="@r" selected>@r</option>
                                    }
                                    else
                                    {
                                        <option value="@r">@r</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn auth-submit-btn">Guardar cambios</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="passwordModal-@usuario.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-action="CambiarPassword" method="post">
                    <input type="hidden" name="Id" value="@usuario.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title">Cambiar contraseña &mdash; @usuario.Nombre</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">Nueva contraseña</label>
                            <div class="auth-password-wrapper">
                                <input name="NuevaPassword" type="password" id="nuevaPass-@usuario.Id" class="form-control auth-input" minlength="4" required />
                                <button type="button" class="auth-password-toggle" data-toggle-password="nuevaPass-@usuario.Id" aria-label="Mostrar contraseña">
                                    @Html.Raw(EyeIcon())
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Confirmar contraseña</label>
                            <div class="auth-password-wrapper">
                                <input name="ConfirmarPassword" type="password" id="confirmarPass-@usuario.Id" class="form-control auth-input" minlength="4" required data-match-password="nuevaPass-@usuario.Id" />
                                <button type="button" class="auth-password-toggle" data-toggle-password="confirmarPass-@usuario.Id" aria-label="Mostrar contraseña">
                                    @Html.Raw(EyeIcon())
                                </button>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn auth-submit-btn">Actualizar contraseña</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="confirmDeactivate-@usuario.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center pt-4">
                    <div class="confirm-modal-icon confirm-modal-icon-danger">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4M12 17h.01" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M10.3 3.9 2.5 17.5A1.5 1.5 0 0 0 3.8 20h16.4a1.5 1.5 0 0 0 1.3-2.5L13.7 3.9a1.5 1.5 0 0 0-2.4 0z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                    </div>
                    <h5 class="modal-title mb-2">¿Desactivar a @usuario.Nombre?</h5>
                    <p class="text-muted mb-0">Esta persona no podrá iniciar sesión hasta que la actives de nuevo.</p>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <form asp-action="ToggleActivo" method="post" class="m-0">
                        <input type="hidden" name="id" value="@usuario.Id" />
                        <button type="submit" class="btn btn-danger">Sí, desactivar</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
}

@functions {
    string EyeIcon() =>
        "<svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7z\" stroke=\"currentColor\" stroke-width=\"1.6\"/><circle cx=\"12\" cy=\"12\" r=\"3\" stroke=\"currentColor\" stroke-width=\"1.6\"/></svg>";

    string RowIcon(string name) => name switch
    {
        "edit" =>
            "<svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 20h9\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><path d=\"M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linejoin=\"round\"/></svg>",
        "key" =>
            "<svg viewBox=\"0 0 24 24\" fill=\"none\"><circle cx=\"8\" cy=\"15\" r=\"4\" stroke=\"currentColor\" stroke-width=\"1.8\"/><path d=\"M11 12l9-9M17 6l3 3M14 9l2.5 2.5\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>",
        "power" =>
            "<svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M12 3v8\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/><path d=\"M6.5 6.5a8 8 0 1 0 11 0\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\"/></svg>",
        _ => ""
    };
}
