@model List<RethusSalud.Web.Models.Admin.UsuarioInternoViewModel>
@{
    ViewData["Title"] = "Administracion de usuarios";
    Layout = "_AppLayout";
    var roles = (List<string>)ViewBag.Roles;
    var totalActivos = Model.Count(u => u.Activo);
    var totalInactivos = Model.Count(u => !u.Activo);
}

<h1>Administración de usuarios</h1>

<div class="app-stat-row">
    <div class="app-stat-card">
        <span class="app-stat-card-value">@Model.Count</span>
        <span class="app-stat-card-label">Total usuarios</span>
    </div>
    <div class="app-stat-card">
        <span class="app-stat-card-value">@totalActivos</span>
        <span class="app-stat-card-label">Activos</span>
    </div>
    <div class="app-stat-card">
        <span class="app-stat-card-value">@totalInactivos</span>
        <span class="app-stat-card-label">Inactivos</span>
    </div>
</div>

<div class="app-panel">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <form method="get" class="row g-2">
            <div class="col-auto">
                <input type="text" name="nombre" class="form-control" placeholder="Digite el nombre" value="@ViewBag.Nombre" />
            </div>
            <div class="col-auto">
                <select name="rol" class="form-select">
                    <option value="">Roles</option>
                    @foreach (var r in roles)
                    {
                        @if ((string?)ViewBag.Rol == r)
                        {
                            <option value="@r" selected>@r</option>
                        }
                        else
                        {
                            <option value="@r">@r</option>
                        }
                    }
                </select>
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-primary">Buscar</button>
                <a asp-action="Usuarios" class="btn btn-outline-secondary">Limpiar</a>
            </div>
        </form>
        <a class="btn auth-submit-btn" asp-action="Crear">+ Crear usuario</a>
    </div>

    <div class="table-responsive">
        <table class="table">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Identificación</th>
                    <th>Rol</th>
                    <th>Estado</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model)
                {
                    <tr>
                        <td>@usuario.Nombre</td>
                        <td>@usuario.Email</td>
                        <td>@usuario.Rol</td>
                        <td>
                            <span class="app-badge @(usuario.Activo ? "app-badge-success" : "app-badge-muted")">
                                @(usuario.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>
                            <form asp-action="ToggleActivo" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@usuario.Id" />
                                <button type="submit" class="btn btn-sm @(usuario.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                    @(usuario.Activo ? "Desactivar" : "Activar")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">Sin resultados.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
