@{
    ViewData["Title"] = "Mi panel";
    Layout = "_AppLayout";
}

<h1>Bienvenido al panel</h1>
<div class="app-panel">
    <p class="text-muted">Sesion iniciada como <strong>@User.Identity?.Name</strong>.</p>
    <p class="mb-0">Roles: @string.Join(", ", ((System.Security.Claims.ClaimsPrincipal)User).Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))</p>
</div>
