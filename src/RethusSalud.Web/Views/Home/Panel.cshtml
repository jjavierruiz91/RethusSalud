@{
    ViewData["Title"] = "Mi panel";
}

<h1 class="h3">Bienvenido al panel</h1>
<p class="text-muted">Sesion iniciada como <strong>@User.Identity?.Name</strong>.</p>
<p>Roles: @string.Join(", ", ((System.Security.Claims.ClaimsPrincipal)User).Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))</p>
