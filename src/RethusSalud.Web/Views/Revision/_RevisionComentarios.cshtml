@model RethusSalud.Domain.Entities.Solicitud
@using RethusSalud.Domain.Enums
@using RethusSalud.Web.Helpers

<div class="revision-card">
    <div class="revision-card-title mb-2">
        @RevisionIcons.Icon("chat")
        <h2>Historial de revisión</h2>
    </div>

    <div class="revision-historial-timeline">
        @foreach (var comentario in Model.Comentarios.OrderByDescending(c => c.FechaCreacion))
        {
            var etapaNumero = comentario.Etapa.HasValue ? EtapaDisplay.Numero(comentario.Etapa.Value) : 0;
            var etapaEtiqueta = comentario.Etapa.HasValue ? EtapaDisplay.Texto(comentario.Etapa.Value) : null;

            <div class="revision-historial-item">
                <div class="revision-historial-avatar-col">
                    @if (!string.IsNullOrEmpty(comentario.AutorFotoUrl))
                    {
                        <img src="@comentario.AutorFotoUrl" alt="" class="revision-historial-avatar revision-historial-avatar-img" />
                    }
                    else
                    {
                        <span class="revision-historial-avatar revision-historial-avatar-@etapaNumero">@(comentario.AutorNombre.Length > 0 ? comentario.AutorNombre[0].ToString().ToUpper() : "F")</span>
                    }
                </div>
                <div class="revision-historial-card">
                    <div class="revision-historial-card-header">
                        <span class="revision-historial-nombre">@(string.IsNullOrWhiteSpace(comentario.AutorNombre) ? "Funcionario" : comentario.AutorNombre)</span>
                        @if (etapaEtiqueta is not null)
                        {
                            <span class="revision-etapa-badge revision-etapa-badge-@etapaNumero">@etapaEtiqueta</span>
                        }
                    </div>
                    <div class="revision-historial-meta">@comentario.FechaCreacion.ToLocalTime().ToString("dd MMM yyyy · hh:mm tt")</div>
                    <p class="revision-historial-text">@comentario.Texto</p>
                </div>
            </div>
        }
    </div>
    @if (!Model.Comentarios.Any())
    {
        <p class="text-muted mb-0">Aun no hay comentarios registrados.</p>
    }

    <form asp-controller="Revision" asp-action="AgregarComentario" method="post" class="revision-comment-form" id="formComentario-@Model.Id">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="volverA" value="@ViewBag.VolverA" />
        <input type="text" name="texto" id="comentarioTexto-@Model.Id" class="form-control" placeholder="Escribe un comentario..." required />
        <button type="submit" class="btn btn-primary revision-comment-send">@RevisionIcons.Icon("send") Agregar comentario</button>
    </form>

    <div class="modal fade" id="confirmarComentarioModal-@Model.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center pt-4">
                    <div class="confirm-modal-icon confirm-modal-icon-info">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M4 5h16v11H9l-5 4V5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                    </div>
                    <h5 class="modal-title mb-2">¿Agregar este comentario?</h5>
                    <p class="text-muted mb-3">Quedará visible en el historial de revisión de esta solicitud.</p>
                    <div class="revision-motivo-preview revision-motivo-preview-info" id="comentarioPreview-@Model.Id"></div>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" id="btnConfirmarComentario-@Model.Id" class="btn btn-primary">Sí, agregar comentario</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var form = document.getElementById('formComentario-@Model.Id');
        var texto = document.getElementById('comentarioTexto-@Model.Id');
        var modalEl = document.getElementById('confirmarComentarioModal-@Model.Id');
        var preview = document.getElementById('comentarioPreview-@Model.Id');
        var btnConfirmar = document.getElementById('btnConfirmarComentario-@Model.Id');

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (!texto.value.trim()) {
                texto.reportValidity();
                return;
            }
            preview.textContent = texto.value.trim();
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
        });

        btnConfirmar.addEventListener('click', function () {
            form.submit();
        });
    })();
</script>
