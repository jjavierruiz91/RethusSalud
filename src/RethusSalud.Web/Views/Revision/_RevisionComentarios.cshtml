@model RethusSalud.Domain.Entities.Solicitud
@using RethusSalud.Domain.Enums
@using RethusSalud.Web.Helpers
@{
    var autoresRechazo = ViewBag.AutoresRechazo as Dictionary<string, string> ?? new Dictionary<string, string>();

    var itemsRechazo = Model.Historial
        .Where(h => h.EstadoResultante == EstadoSolicitud.Rechazado)
        .Select(h => new
        {
            Fecha = h.Fecha,
            AutorNombre = autoresRechazo.TryGetValue(h.UsuarioId, out var nombre) ? nombre : "Funcionario",
            AutorFotoUrl = (string?)null,
            EtapaNumero = h.EtapaResultante.HasValue ? EtapaDisplay.Numero(h.EtapaResultante.Value) : 0,
            EtapaEtiqueta = h.EtapaResultante.HasValue ? EtapaDisplay.Texto(h.EtapaResultante.Value) : null,
            Texto = h.Motivo ?? string.Empty,
            EsRechazo = true
        });

    var itemsComentario = Model.Comentarios
        .Select(c => new
        {
            Fecha = c.FechaCreacion,
            AutorNombre = string.IsNullOrWhiteSpace(c.AutorNombre) ? "Funcionario" : c.AutorNombre,
            AutorFotoUrl = c.AutorFotoUrl,
            EtapaNumero = c.Etapa.HasValue ? EtapaDisplay.Numero(c.Etapa.Value) : 0,
            EtapaEtiqueta = c.Etapa.HasValue ? EtapaDisplay.Texto(c.Etapa.Value) : null,
            Texto = c.Texto,
            EsRechazo = false
        });

    var timeline = itemsRechazo.Concat(itemsComentario).OrderByDescending(i => i.Fecha).ToList();
}

<div class="revision-card">
    <div class="revision-card-title mb-2">
        @RevisionIcons.Icon("chat")
        <h2>Historial de revisión</h2>
    </div>

    <div class="revision-historial-timeline">
        @foreach (var item in timeline)
        {
            <div class="revision-historial-item">
                <div class="revision-historial-avatar-col">
                    @if (!string.IsNullOrEmpty(item.AutorFotoUrl))
                    {
                        <img src="@item.AutorFotoUrl" alt="" class="revision-historial-avatar revision-historial-avatar-img" />
                    }
                    else
                    {
                        <span class="revision-historial-avatar @(item.EsRechazo ? "revision-historial-avatar-rechazo" : $"revision-historial-avatar-{item.EtapaNumero}")">@(item.AutorNombre.Length > 0 ? item.AutorNombre[0].ToString().ToUpper() : "F")</span>
                    }
                </div>
                <div class="revision-historial-card @(item.EsRechazo ? "revision-historial-card-rechazo" : "")">
                    <div class="revision-historial-card-header">
                        <span class="revision-historial-nombre">@item.AutorNombre</span>
                        @if (item.EsRechazo)
                        {
                            <span class="revision-etapa-badge revision-etapa-badge-rechazo">Rechazo@(item.EtapaEtiqueta is not null ? $" · {item.EtapaEtiqueta}" : "")</span>
                        }
                        else if (item.EtapaEtiqueta is not null)
                        {
                            <span class="revision-etapa-badge revision-etapa-badge-@item.EtapaNumero">@item.EtapaEtiqueta</span>
                        }
                    </div>
                    <div class="revision-historial-meta">@item.Fecha.ToLocalTime().ToString("dd MMM yyyy · hh:mm tt")</div>
                    <p class="revision-historial-text">@item.Texto</p>
                </div>
            </div>
        }
    </div>
    @if (!timeline.Any())
    {
        <p class="text-muted mb-0">Aun no hay comentarios registrados.</p>
    }

    <form asp-controller="Revision" asp-action="AgregarComentario" method="post" class="revision-comment-form" id="formComentario-@Model.Id">
        <input type="hidden" name="id" value="@Model.Id" />
        <input type="hidden" name="volverA" value="@ViewBag.VolverA" />
        <input type="text" name="texto" id="comentarioTexto-@Model.Id" class="form-control" placeholder="Escribe un comentario..." required />
        <button type="submit" class="btn btn-primary revision-comment-send">@RevisionIcons.Icon("send") Agregar comentario</button>
    </form>

    <div class="modal fade" id="confirmarComentarioModal-@Model.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center pt-4">
                    <div class="confirm-modal-icon confirm-modal-icon-info">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M4 5h16v11H9l-5 4V5z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
                    </div>
                    <h5 class="modal-title mb-2">¿Agregar este comentario?</h5>
                    <p class="text-muted mb-3">Quedará visible en el historial de revisión de esta solicitud.</p>
                    <div class="revision-motivo-preview revision-motivo-preview-info" id="comentarioPreview-@Model.Id"></div>
                </div>
                <div class="modal-footer border-0 justify-content-center pb-4">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" id="btnConfirmarComentario-@Model.Id" class="btn btn-primary">Sí, agregar comentario</button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var form = document.getElementById('formComentario-@Model.Id');
        var texto = document.getElementById('comentarioTexto-@Model.Id');
        var modalEl = document.getElementById('confirmarComentarioModal-@Model.Id');
        var preview = document.getElementById('comentarioPreview-@Model.Id');
        var btnConfirmar = document.getElementById('btnConfirmarComentario-@Model.Id');

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            if (!texto.value.trim()) {
                texto.reportValidity();
                return;
            }
            preview.textContent = texto.value.trim();
            bootstrap.Modal.getOrCreateInstance(modalEl).show();
        });

        btnConfirmar.addEventListener('click', function () {
            form.submit();
        });
    })();
</script>
