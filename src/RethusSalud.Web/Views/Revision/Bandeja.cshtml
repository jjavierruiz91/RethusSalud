@model RethusSalud.Web.Models.Revision.BandejaViewModel
@using RethusSalud.Domain.Enums
@using RethusSalud.Web.Helpers
@using RethusSalud.Web.Models.Shared
@{
    ViewData["Title"] = "Bandeja de revision";
    Layout = "_AppLayout";
    var totalEnProceso = Model.TotalEnProceso;
    var totalAprobadas = Model.TotalAprobadas;
    var totalEsperandoLargo = Model.TotalEsperandoLargo;

    string BadgeEstado(EstadoSolicitud e) => e switch
    {
        EstadoSolicitud.Aprobado => "app-badge-success",
        EstadoSolicitud.Rechazado => "app-badge-danger",
        EstadoSolicitud.EnProceso => "app-badge-warning",
        _ => "app-badge-muted"
    };

    var paginacion = new PaginacionViewModel
    {
        PaginaActual = Model.Pagina.PageNumber,
        TotalPaginas = Model.Pagina.TotalPages,
        TotalRegistros = Model.Pagina.TotalCount,
        Accion = "Bandeja",
        RouteValues = new Dictionary<string, string?>
        {
            ["NumeroIdentificacion"] = Model.Filtro.NumeroIdentificacion,
            ["TipoTramite"] = Model.Filtro.TipoTramite?.ToString(),
            ["Estado"] = Model.Filtro.Estado?.ToString(),
            ["Desde"] = Model.Filtro.Desde?.ToString("yyyy-MM-dd"),
            ["Hasta"] = Model.Filtro.Hasta?.ToString("yyyy-MM-dd")
        }
    };
}

<div class="app-stat-row">
    <div class="app-stat-card app-stat-card--brand">
        <span class="app-stat-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 12h-6l-2 3h-4l-2-3H2" /><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11Z" /></svg>
        </span>
        <span class="app-stat-card-value">@Model.Pagina.TotalCount</span>
        <span class="app-stat-card-label">Total en bandeja</span>
    </div>
    <div class="app-stat-card app-stat-card--teal">
        <span class="app-stat-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3.35-7.02" /><path d="M21 3v6h-6" /></svg>
        </span>
        <span class="app-stat-card-value">@totalEnProceso</span>
        <span class="app-stat-card-label">En proceso</span>
    </div>
    <div class="app-stat-card app-stat-card--warning">
        <span class="app-stat-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 3" /></svg>
        </span>
        <span class="app-stat-card-value">@totalEsperandoLargo</span>
        <span class="app-stat-card-label">Esperando &gt; 2 días</span>
    </div>
    <div class="app-stat-card app-stat-card--success">
        <span class="app-stat-card-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><path d="m22 4-10 10.01-3-3" /></svg>
        </span>
        <span class="app-stat-card-value">@totalAprobadas</span>
        <span class="app-stat-card-label">Aprobadas</span>
    </div>
</div>

<div class="app-panel">
<form method="get" class="row g-3 mb-3 align-items-end" data-autosubmit>
    <div class="col-12 col-sm-6 col-lg-3">
        <label class="form-label small text-muted mb-1">Identificación</label>
        <input type="text" name="NumeroIdentificacion" class="form-control" placeholder="Número de identificación" value="@Model.Filtro.NumeroIdentificacion" />
    </div>
    <div class="col-6 col-sm-4 col-lg-2">
        <label class="form-label small text-muted mb-1">Tipo de trámite</label>
        <select name="TipoTramite" class="form-select" onchange="this.form.submit()">
            <option value="">Todos</option>
            @foreach (var tipo in Enum.GetValues<TipoTramite>())
            {
                @if (Model.Filtro.TipoTramite == tipo)
                {
                    <option value="@tipo" selected>@tipo</option>
                }
                else
                {
                    <option value="@tipo">@tipo</option>
                }
            }
        </select>
    </div>
    <div class="col-6 col-sm-4 col-lg-2">
        <label class="form-label small text-muted mb-1">Estado</label>
        <select name="Estado" class="form-select" onchange="this.form.submit()">
            <option value="">Todos</option>
            @foreach (var estado in EstadoDisplay.FiltrablesPorFuncionario)
            {
                @if (Model.Filtro.Estado == estado)
                {
                    <option value="@estado" selected>@EstadoDisplay.Texto(estado)</option>
                }
                else
                {
                    <option value="@estado">@EstadoDisplay.Texto(estado)</option>
                }
            }
        </select>
    </div>
    <div class="col-6 col-sm-6 col-lg-2">
        <label class="form-label small text-muted mb-1">Desde</label>
        <input type="date" name="Desde" class="form-control" value="@Model.Filtro.Desde?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-6 col-sm-6 col-lg-2">
        <label class="form-label small text-muted mb-1">Hasta</label>
        <input type="date" name="Hasta" class="form-control" value="@Model.Filtro.Hasta?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-12 d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        <a asp-action="Bandeja" class="btn btn-outline-secondary">Limpiar</a>
        <a asp-action="ExportarExcel"
           asp-route-NumeroIdentificacion="@Model.Filtro.NumeroIdentificacion"
           asp-route-TipoTramite="@Model.Filtro.TipoTramite"
           asp-route-Estado="@Model.Filtro.Estado"
           asp-route-Desde="@Model.Filtro.Desde?.ToString("yyyy-MM-dd")"
           asp-route-Hasta="@Model.Filtro.Hasta?.ToString("yyyy-MM-dd")"
           class="btn btn-outline-success">Exportar</a>
    </div>
</form>

<form id="formLote" asp-action="AsignarConsecutivoRango" method="post">
    @if (Model.Etapa == EtapaSolicitud.Inventario)
    {
        <div class="revision-card d-none" id="barraLote">
            <div class="d-flex align-items-end gap-3 flex-wrap">
                <div>
                    <strong><span id="contadorSeleccion">0</span> seleccionada(s)</strong>
                </div>
                <div>
                    <label class="form-label small text-muted mb-1">Rango inicio</label>
                    <input type="text" name="consecutivoInicial" class="form-control" style="max-width:160px" placeholder="Ej. 2001" pattern="[0-9]+" required />
                </div>
                <div>
                    <label class="form-label small text-muted mb-1">Rango fin</label>
                    <input type="text" name="consecutivoFinal" class="form-control" style="max-width:160px" placeholder="Ej. 2005" pattern="[0-9]+" required />
                </div>
                <div>
                    <label class="form-label small text-muted mb-1">Fecha del consecutivo</label>
                    <input type="date" name="fecha" class="form-control" style="max-width:180px" value="@DateTime.Now.ToString("yyyy-MM-dd")" required />
                </div>
                <button type="submit" class="btn btn-primary">Generar</button>
            </div>
        </div>
    }

    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    @if (Model.Etapa == EtapaSolicitud.Inventario)
                    {
                        <th></th>
                    }
                    <th>Identificación</th>
                    <th>Nombre</th>
                    <th>Tipo de trámite</th>
                    <th>Estado</th>
                    <th>Etapa actual</th>
                    <th>Tiempo transcurrido</th>
                    <th>Consecutivo</th>
                    <th>Fecha de creación</th>
                    <th>Última actualización</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var solicitud in Model.Pagina.Items)
                {
                    var puedeSeleccionar = Model.Etapa == EtapaSolicitud.Inventario && solicitud.Estado == EstadoSolicitud.EnProceso && solicitud.Consecutivo is null;
                    <tr>
                        @if (Model.Etapa == EtapaSolicitud.Inventario)
                        {
                            <td>
                                @if (puedeSeleccionar)
                                {
                                    <input type="checkbox" class="form-check-input seleccion-item" name="ids" value="@solicitud.Id" />
                                }
                            </td>
                        }
                        <td>@solicitud.Solicitante.NumeroIdentificacion</td>
                        <td>@solicitud.Solicitante.Nombres @solicitud.Solicitante.Apellidos</td>
                        <td>@solicitud.TipoTramite</td>
                        <td><span class="app-badge @BadgeEstado(solicitud.Estado)">@EstadoDisplay.Texto(solicitud.Estado)</span></td>
                        <td>@(solicitud.EtapaActual?.ToString() ?? "-")</td>
                        <td>@TiempoDisplay.Transcurrido(solicitud.FechaCreacion)</td>
                        <td>@(solicitud.Consecutivo is not null ? solicitud.Consecutivo.Numero : "No asignado")</td>
                        <td>@solicitud.FechaCreacion.ToLocalTime().ToString("dd MMM yy, HH:mm")</td>
                        <td>@solicitud.FechaActualizacion.ToLocalTime().ToString("dd MMM yy, HH:mm")</td>
                        <td class="text-end"><a class="btn btn-sm btn-primary" asp-action="Detalle" asp-route-id="@solicitud.Id">Revisar</a></td>
                    </tr>
                }
                @if (!Model.Pagina.Items.Any())
                {
                    <tr>
                        <td colspan="10" class="text-center text-muted">Sin resultados. No hay informacion disponible que coincida con tu busqueda.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</form>

<partial name="_Pagination" model="paginacion" />
</div>

@if (Model.Etapa == EtapaSolicitud.Inventario)
{
    <script>
        (function () {
            var checkboxes = document.querySelectorAll('.seleccion-item');
            var barra = document.getElementById('barraLote');
            var contador = document.getElementById('contadorSeleccion');

            function actualizar() {
                var marcados = document.querySelectorAll('.seleccion-item:checked').length;
                contador.textContent = marcados;
                barra.classList.toggle('d-none', marcados === 0);
            }

            checkboxes.forEach(function (cb) { cb.addEventListener('change', actualizar); });
        })();
    </script>
}
