@model RethusSalud.Web.Models.Revision.BandejaViewModel
@using RethusSalud.Domain.Enums
@using RethusSalud.Web.Helpers
@{
    ViewData["Title"] = "Bandeja de revision";
    Layout = "_AppLayout";
    var totalEnProceso = Model.Solicitudes.Count(s => s.Estado == EstadoSolicitud.EnProceso);
    var totalAprobadas = Model.Solicitudes.Count(s => s.Estado == EstadoSolicitud.Aprobado);
    var totalEsperandoLargo = Model.Solicitudes.Count(s =>
        s.Estado == EstadoSolicitud.EnProceso && (DateTime.UtcNow - s.FechaCreacion).TotalDays > 2);

    string BadgeEstado(EstadoSolicitud e) => e switch
    {
        EstadoSolicitud.Aprobado => "app-badge-success",
        EstadoSolicitud.Rechazado => "app-badge-danger",
        EstadoSolicitud.EnProceso => "app-badge-warning",
        _ => "app-badge-muted"
    };

    string Iniciales(RethusSalud.Domain.Entities.Solicitante s)
    {
        var n = s.Nombres.Length > 0 ? s.Nombres[0].ToString() : "";
        var a = s.Apellidos.Length > 0 ? s.Apellidos[0].ToString() : "";
        return (n + a).ToUpperInvariant();
    }

    (string Texto, bool Alerta) TiempoEspera(RethusSalud.Domain.Entities.Solicitud s)
    {
        if (s.Estado != EstadoSolicitud.EnProceso)
        {
            return ("", false);
        }

        var dias = (DateTime.UtcNow - s.FechaCreacion).TotalDays;
        if (dias < 1)
        {
            return ("Hoy", false);
        }

        var enteros = (int)dias;
        var texto = $"{enteros} día{(enteros == 1 ? "" : "s")} esperando";
        return (texto, dias > 2);
    }
}

<nav class="revision-breadcrumb">
    <span class="current">Inicio</span>
    <span>&rsaquo;</span>
    <span class="current">Bandeja de revisión</span>
</nav>

<h1>Bandeja de revisión</h1>
<p class="text-muted mb-3">Etapa @Model.Etapa &middot; @Model.Solicitudes.Count solicitud(es) ReTHUS en tu bandeja</p>

<div class="app-stat-row">
    <div class="app-stat-card">
        <span class="app-stat-card-value">@Model.Solicitudes.Count</span>
        <span class="app-stat-card-label">Total en bandeja</span>
    </div>
    <div class="app-stat-card">
        <span class="app-stat-card-value">@totalEnProceso</span>
        <span class="app-stat-card-label">En proceso</span>
    </div>
    <div class="app-stat-card">
        <span class="app-stat-card-value" style="color:#b9770e">@totalEsperandoLargo</span>
        <span class="app-stat-card-label">Esperando &gt; 2 días</span>
    </div>
    <div class="app-stat-card">
        <span class="app-stat-card-value">@totalAprobadas</span>
        <span class="app-stat-card-label">Aprobadas</span>
    </div>
</div>

<div class="app-panel">
<form method="get" class="row g-3 mb-3 align-items-end">
    <div class="col-12 col-sm-6 col-lg-3">
        <label class="form-label small text-muted mb-1">Identificación</label>
        <input type="text" name="NumeroIdentificacion" class="form-control" placeholder="Número de identificación" value="@Model.Filtro.NumeroIdentificacion" />
    </div>
    <div class="col-6 col-sm-4 col-lg-2">
        <label class="form-label small text-muted mb-1">Tipo de trámite</label>
        <select name="TipoTramite" class="form-select" onchange="this.form.submit()">
            <option value="">Todos</option>
            @foreach (var tipo in Enum.GetValues<TipoTramite>())
            {
                @if (Model.Filtro.TipoTramite == tipo)
                {
                    <option value="@tipo" selected>@tipo</option>
                }
                else
                {
                    <option value="@tipo">@tipo</option>
                }
            }
        </select>
    </div>
    <div class="col-6 col-sm-4 col-lg-2">
        <label class="form-label small text-muted mb-1">Estado</label>
        <select name="Estado" class="form-select" onchange="this.form.submit()">
            <option value="">Todos</option>
            @foreach (var estado in EstadoDisplay.FiltrablesPorFuncionario)
            {
                @if (Model.Filtro.Estado == estado)
                {
                    <option value="@estado" selected>@EstadoDisplay.Texto(estado)</option>
                }
                else
                {
                    <option value="@estado">@EstadoDisplay.Texto(estado)</option>
                }
            }
        </select>
    </div>
    <div class="col-6 col-sm-6 col-lg-2">
        <label class="form-label small text-muted mb-1">Desde</label>
        <input type="date" name="Desde" class="form-control" value="@Model.Filtro.Desde?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-6 col-sm-6 col-lg-2">
        <label class="form-label small text-muted mb-1">Hasta</label>
        <input type="date" name="Hasta" class="form-control" value="@Model.Filtro.Hasta?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-12 d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        <a asp-action="Bandeja" class="btn btn-outline-secondary">Limpiar</a>
        <a asp-action="ExportarExcel"
           asp-route-NumeroIdentificacion="@Model.Filtro.NumeroIdentificacion"
           asp-route-TipoTramite="@Model.Filtro.TipoTramite"
           asp-route-Estado="@Model.Filtro.Estado"
           asp-route-Desde="@Model.Filtro.Desde?.ToString("yyyy-MM-dd")"
           asp-route-Hasta="@Model.Filtro.Hasta?.ToString("yyyy-MM-dd")"
           class="btn btn-outline-success">Exportar</a>
    </div>
</form>

<form id="formLote" asp-action="AsignarConsecutivoRango" method="post">
    @if (Model.Etapa == EtapaSolicitud.Inventario)
    {
        <div class="revision-card d-none" id="barraLote">
            <div class="d-flex align-items-center gap-3 flex-wrap">
                <strong><span id="contadorSeleccion">0</span> seleccionada(s)</strong>
                <input type="text" name="consecutivoInicial" class="form-control" style="max-width:220px" placeholder="Consecutivo inicial (ej. 2001)" pattern="[0-9]+" required />
                <button type="submit" class="btn btn-primary">Asignar rango y aprobar</button>
            </div>
        </div>
    }

    @foreach (var solicitud in Model.Solicitudes)
    {
        var espera = TiempoEspera(solicitud);
        var puedeSeleccionar = Model.Etapa == EtapaSolicitud.Inventario && solicitud.Estado == EstadoSolicitud.EnProceso && solicitud.Consecutivo is null;
        <div class="revision-list-item @(espera.Alerta ? "alerta" : "")">
            @if (puedeSeleccionar)
            {
                <input type="checkbox" class="form-check-input seleccion-item" name="ids" value="@solicitud.Id" />
            }
            <span class="revision-list-avatar">@Iniciales(solicitud.Solicitante)</span>
            <div class="revision-list-main">
                <div class="revision-list-name">@solicitud.Solicitante.Nombres @solicitud.Solicitante.Apellidos</div>
                <div class="revision-list-sub">@solicitud.Solicitante.TipoIdentificacion @solicitud.Solicitante.NumeroIdentificacion &middot; @solicitud.TipoTramite</div>
            </div>
            <span class="app-badge @BadgeEstado(solicitud.Estado)">@EstadoDisplay.Texto(solicitud.Estado)</span>
            @if (!string.IsNullOrEmpty(espera.Texto))
            {
                <span class="revision-wait-badge @(espera.Alerta ? "alerta" : "")">@espera.Texto</span>
            }
            <a class="btn btn-sm btn-primary" asp-action="Detalle" asp-route-id="@solicitud.Id">Revisar</a>
        </div>
    }
    @if (!Model.Solicitudes.Any())
    {
        <p class="text-center text-muted mb-0">Sin resultados. No hay informacion disponible que coincida con tu busqueda.</p>
    }
</form>
</div>

@if (Model.Etapa == EtapaSolicitud.Inventario)
{
    <script>
        (function () {
            var checkboxes = document.querySelectorAll('.seleccion-item');
            var barra = document.getElementById('barraLote');
            var contador = document.getElementById('contadorSeleccion');

            function actualizar() {
                var marcados = document.querySelectorAll('.seleccion-item:checked').length;
                contador.textContent = marcados;
                barra.classList.toggle('d-none', marcados === 0);
            }

            checkboxes.forEach(function (cb) { cb.addEventListener('change', actualizar); });
        })();
    </script>
}
