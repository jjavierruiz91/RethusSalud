@model RethusSalud.Web.Models.Revision.BandejaViewModel
@using RethusSalud.Domain.Enums
@{
    ViewData["Title"] = "Bandeja de revision";
}

<h1 class="h4">Usuarios - @Model.Etapa</h1>

@if (TempData["Mensaje"] is string mensaje)
{
    <div class="alert alert-success">@mensaje</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <input type="text" name="NumeroIdentificacion" class="form-control" placeholder="Identificacion" value="@Model.Filtro.NumeroIdentificacion" />
    </div>
    <div class="col-auto">
        <select name="TipoTramite" class="form-select">
            <option value="">Tipo de tramite</option>
            @foreach (var tipo in Enum.GetValues<TipoTramite>())
            {
                @if (Model.Filtro.TipoTramite == tipo)
                {
                    <option value="@tipo" selected>@tipo</option>
                }
                else
                {
                    <option value="@tipo">@tipo</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <select name="Estado" class="form-select">
            <option value="">Estados</option>
            @foreach (var estado in Enum.GetValues<EstadoSolicitud>())
            {
                @if (Model.Filtro.Estado == estado)
                {
                    <option value="@estado" selected>@estado</option>
                }
                else
                {
                    <option value="@estado">@estado</option>
                }
            }
        </select>
    </div>
    <div class="col-auto">
        <input type="date" name="Desde" class="form-control" value="@Model.Filtro.Desde?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <input type="date" name="Hasta" class="form-control" value="@Model.Filtro.Hasta?.ToString("yyyy-MM-dd")" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary">Buscar</button>
        <a asp-action="Bandeja" class="btn btn-outline-secondary">Limpiar</a>
        <a asp-action="ExportarExcel"
           asp-route-NumeroIdentificacion="@Model.Filtro.NumeroIdentificacion"
           asp-route-TipoTramite="@Model.Filtro.TipoTramite"
           asp-route-Estado="@Model.Filtro.Estado"
           asp-route-Desde="@Model.Filtro.Desde?.ToString("yyyy-MM-dd")"
           asp-route-Hasta="@Model.Filtro.Hasta?.ToString("yyyy-MM-dd")"
           class="btn btn-outline-success">Generar excel</a>
    </div>
</form>

<table class="table table-bordered bg-white">
    <thead>
        <tr>
            <th>Identificacion</th>
            <th>Nombre</th>
            <th>Tipo de tramite</th>
            <th>Estado</th>
            <th>Etapa actual</th>
            <th>Fecha de creacion</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var solicitud in Model.Solicitudes)
        {
            <tr>
                <td>@solicitud.Solicitante.NumeroIdentificacion</td>
                <td>@solicitud.Solicitante.Nombres @solicitud.Solicitante.Apellidos</td>
                <td>@solicitud.TipoTramite</td>
                <td>@solicitud.Estado</td>
                <td>@solicitud.EtapaActual</td>
                <td>@solicitud.FechaCreacion.ToLocalTime().ToString("dd MMM yy, HH:mm")</td>
                <td>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Detalle" asp-route-id="@solicitud.Id">Revisar</a>
                </td>
            </tr>
        }
        @if (!Model.Solicitudes.Any())
        {
            <tr>
                <td colspan="7" class="text-center text-muted">Sin resultados. No hay informacion disponible que coincida con tu busqueda.</td>
            </tr>
        }
    </tbody>
</table>
