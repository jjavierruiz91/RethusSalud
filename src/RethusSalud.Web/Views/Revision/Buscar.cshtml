@model RethusSalud.Web.Models.Revision.BuscarViewModel
@using RethusSalud.Domain.Enums
@using RethusSalud.Web.Helpers
@using RethusSalud.Web.Models.Shared
@{
    ViewData["Title"] = "Buscar solicitud";
    Layout = "_AppLayout";

    string BadgeEstado(EstadoSolicitud e) => e switch
    {
        EstadoSolicitud.Aprobado => "app-badge-success",
        EstadoSolicitud.Rechazado => "app-badge-danger",
        EstadoSolicitud.EnProceso => "app-badge-warning",
        _ => "app-badge-muted"
    };

    var paginacion = new PaginacionViewModel
    {
        PaginaActual = Model.Pagina.PageNumber,
        TotalPaginas = Model.Pagina.TotalPages,
        TotalRegistros = Model.Pagina.TotalCount,
        Accion = "Buscar",
        RouteValues = new Dictionary<string, string?>
        {
            ["NumeroIdentificacion"] = Model.Filtro.NumeroIdentificacion,
            ["TipoTramite"] = Model.Filtro.TipoTramite?.ToString(),
            ["Etapa"] = Model.Filtro.Etapa?.ToString(),
            ["Estado"] = Model.Filtro.Estado?.ToString(),
            ["Desde"] = Model.Filtro.Desde?.ToString("yyyy-MM-dd"),
            ["Hasta"] = Model.Filtro.Hasta?.ToString("yyyy-MM-dd")
        }
    };
}

<div class="app-panel">
<form method="get" class="row g-3 mb-3 align-items-end">
    <div class="col-12 col-sm-6 col-lg-3">
        <label class="form-label small text-muted mb-1">Identificación</label>
        <input type="text" name="NumeroIdentificacion" class="form-control" placeholder="Número de identificación" value="@Model.Filtro.NumeroIdentificacion" />
    </div>
    <div class="col-6 col-sm-4 col-lg-2">
        <label class="form-label small text-muted mb-1">Tipo de trámite</label>
        <select name="TipoTramite" class="form-select" onchange="this.form.submit()">
            <option value="">Todos</option>
            @foreach (var tipo in Enum.GetValues<TipoTramite>())
            {
                @if (Model.Filtro.TipoTramite == tipo)
                {
                    <option value="@tipo" selected>@tipo</option>
                }
                else
                {
                    <option value="@tipo">@tipo</option>
                }
            }
        </select>
    </div>
    <div class="col-6 col-sm-4 col-lg-2">
        <label class="form-label small text-muted mb-1">Etapa</label>
        <select name="Etapa" class="form-select" onchange="this.form.submit()">
            <option value="">Todas</option>
            @foreach (var etapa in Enum.GetValues<EtapaSolicitud>())
            {
                @if (Model.Filtro.Etapa == etapa)
                {
                    <option value="@etapa" selected>@etapa</option>
                }
                else
                {
                    <option value="@etapa">@etapa</option>
                }
            }
        </select>
    </div>
    <div class="col-6 col-sm-4 col-lg-2">
        <label class="form-label small text-muted mb-1">Estado</label>
        <select name="Estado" class="form-select" onchange="this.form.submit()">
            <option value="">Todos</option>
            @foreach (var estado in EstadoDisplay.FiltrablesPorFuncionario)
            {
                @if (Model.Filtro.Estado == estado)
                {
                    <option value="@estado" selected>@EstadoDisplay.Texto(estado)</option>
                }
                else
                {
                    <option value="@estado">@EstadoDisplay.Texto(estado)</option>
                }
            }
        </select>
    </div>
    <div class="col-6 col-sm-6 col-lg-3">
        <label class="form-label small text-muted mb-1">&nbsp;</label>
        <button type="submit" class="btn btn-outline-primary w-100">Buscar</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Identificación</th>
                <th>Nombre</th>
                <th>Tipo de trámite</th>
                <th>Estado</th>
                <th>Etapa actual</th>
                <th>Consecutivo</th>
                <th>Fecha de creación</th>
                <th>Última actualización</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var solicitud in Model.Pagina.Items)
            {
                <tr>
                    <td>@solicitud.Solicitante.NumeroIdentificacion</td>
                    <td>@solicitud.Solicitante.Nombres @solicitud.Solicitante.Apellidos</td>
                    <td>@solicitud.TipoTramite</td>
                    <td><span class="app-badge @BadgeEstado(solicitud.Estado)">@EstadoDisplay.Texto(solicitud.Estado)</span></td>
                    <td>@(solicitud.EtapaActual?.ToString() ?? "-")</td>
                    <td>@(solicitud.Consecutivo is not null ? solicitud.Consecutivo.Numero : "No asignado")</td>
                    <td>@solicitud.FechaCreacion.ToLocalTime().ToString("dd MMM yy, HH:mm")</td>
                    <td>@solicitud.FechaActualizacion.ToLocalTime().ToString("dd MMM yy, HH:mm")</td>
                    <td class="text-end"><a class="btn btn-sm btn-primary" asp-action="Detalle" asp-route-id="@solicitud.Id">Ver seguimiento</a></td>
                </tr>
            }
            @if (!Model.Pagina.Items.Any())
            {
                <tr>
                    <td colspan="9" class="text-center text-muted">Sin resultados. No hay solicitudes que coincidan con tu busqueda.</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model="paginacion" />
</div>
