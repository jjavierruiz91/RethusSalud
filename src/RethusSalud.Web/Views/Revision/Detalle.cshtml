@model RethusSalud.Domain.Entities.Solicitud
@using RethusSalud.Domain.Enums
@using RethusSalud.Web.Helpers
@{
    ViewData["Title"] = "Revision de usuario";
    Layout = "_AppLayout";
    ViewBag.PasoActual = 0;
    ViewBag.NombrePaso = "Información personal";

    string Clase(string? v) => string.IsNullOrWhiteSpace(v) ? "text-danger" : "";
    string Valor(string? v) => string.IsNullOrWhiteSpace(v) ? "Sin diligenciar" : v;
    string ClaseFecha(DateOnly f) => f == default ? "text-danger" : "";
    string ValorFecha(DateOnly f) => f == default ? "Sin diligenciar" : f.ToString("dd/MM/yyyy");
    string ClaseGenero(Genero g) => Enum.IsDefined(typeof(Genero), g) ? "" : "text-danger";
    string ValorGenero(Genero g) => Enum.IsDefined(typeof(Genero), g) ? g.ToString() : "Sin diligenciar";
}

@await Html.PartialAsync("_RevisionHeader", Model)

<div class="row">
    <div class="col-md-8">
        <div class="revision-card">
            <div class="revision-card-header">
                <div class="revision-card-title">
                    @RevisionIcons.Icon("person")
                    <div>
                        <h2>Información personal</h2>
                        <p>Datos básicos del usuario</p>
                    </div>
                </div>
            </div>

            <div class="revision-section-label">Información de identificación</div>
            <div class="revision-field-grid">
                <div class="revision-field">
                    <span class="revision-field-icon">@RevisionIcons.Icon("id")</span>
                    <span>
                        <span class="revision-field-label">Tipo de documento</span>
                        <span class="revision-field-value">@Model.Solicitante.TipoIdentificacion</span>
                    </span>
                </div>
                <div class="revision-field">
                    <span class="revision-field-icon">@RevisionIcons.Icon("hash")</span>
                    <span>
                        <span class="revision-field-label">Número de identificación</span>
                        <span class="revision-field-value">@Model.Solicitante.NumeroIdentificacion</span>
                    </span>
                </div>
                <div class="revision-field">
                    <span class="revision-field-icon">@RevisionIcons.Icon("pin")</span>
                    <span>
                        <span class="revision-field-label">Lugar de expedición</span>
                        <span class="revision-field-value @Clase(Model.Solicitante.LugarExpedicion)">@Valor(Model.Solicitante.LugarExpedicion)</span>
                    </span>
                </div>
            </div>

            <div class="revision-section-label">Información personal</div>
            <div class="revision-field-grid">
                <div class="revision-field">
                    <span class="revision-field-icon">@RevisionIcons.Icon("person")</span>
                    <span>
                        <span class="revision-field-label">Nombres</span>
                        <span class="revision-field-value @Clase(Model.Solicitante.Nombres)">@Valor(Model.Solicitante.Nombres)</span>
                    </span>
                </div>
                <div class="revision-field">
                    <span class="revision-field-icon">@RevisionIcons.Icon("person")</span>
                    <span>
                        <span class="revision-field-label">Apellidos</span>
                        <span class="revision-field-value @Clase(Model.Solicitante.Apellidos)">@Valor(Model.Solicitante.Apellidos)</span>
                    </span>
                </div>
                <div class="revision-field">
                    <span class="revision-field-icon">@RevisionIcons.Icon("phone")</span>
                    <span>
                        <span class="revision-field-label">Celular</span>
                        <span class="revision-field-value @Clase(Model.Solicitante.Celular)">@Valor(Model.Solicitante.Celular)</span>
                    </span>
                </div>
                <div class="revision-field">
                    <span class="revision-field-icon">@RevisionIcons.Icon("person")</span>
                    <span>
                        <span class="revision-field-label">Género</span>
                        <span class="revision-field-value @ClaseGenero(Model.Solicitante.Genero)">@ValorGenero(Model.Solicitante.Genero)</span>
                    </span>
                </div>
                <div class="revision-field">
                    <span class="revision-field-icon">@RevisionIcons.Icon("mail")</span>
                    <span>
                        <span class="revision-field-label">Correo electrónico</span>
                        <span class="revision-field-value @Clase(Model.Solicitante.CorreoElectronico)">@Valor(Model.Solicitante.CorreoElectronico)</span>
                    </span>
                </div>
                <div class="revision-field">
                    <span class="revision-field-icon">@RevisionIcons.Icon("calendar")</span>
                    <span>
                        <span class="revision-field-label">Fecha de nacimiento</span>
                        <span class="revision-field-value @ClaseFecha(Model.Solicitante.FechaNacimiento)">@ValorFecha(Model.Solicitante.FechaNacimiento)</span>
                    </span>
                </div>
            </div>

            <div class="revision-section-label">Información de nacimiento y residencia</div>
            <div class="revision-field-grid">
                <div class="revision-field">
                    <span class="revision-field-icon">@RevisionIcons.Icon("globe")</span>
                    <span>
                        <span class="revision-field-label">País de nacimiento</span>
                        <span class="revision-field-value @Clase(Model.Solicitante.PaisNacimiento?.Nombre)">@Valor(Model.Solicitante.PaisNacimiento?.Nombre)</span>
                    </span>
                </div>
                <div class="revision-field">
                    <span class="revision-field-icon">@RevisionIcons.Icon("pin")</span>
                    <span>
                        <span class="revision-field-label">Departamento de nacimiento</span>
                        <span class="revision-field-value @Clase(Model.Solicitante.DepartamentoNacimiento?.Nombre)">@Valor(Model.Solicitante.DepartamentoNacimiento?.Nombre)</span>
                    </span>
                </div>
                <div class="revision-field">
                    <span class="revision-field-icon">@RevisionIcons.Icon("pin")</span>
                    <span>
                        <span class="revision-field-label">Municipio de nacimiento</span>
                        <span class="revision-field-value @Clase(Model.Solicitante.MunicipioNacimiento?.Nombre)">@Valor(Model.Solicitante.MunicipioNacimiento?.Nombre)</span>
                    </span>
                </div>
                <div class="revision-field">
                    <span class="revision-field-icon">@RevisionIcons.Icon("pin")</span>
                    <span>
                        <span class="revision-field-label">Departamento de residencia</span>
                        <span class="revision-field-value @Clase(Model.Solicitante.DepartamentoResidencia?.Nombre)">@Valor(Model.Solicitante.DepartamentoResidencia?.Nombre)</span>
                    </span>
                </div>
                <div class="revision-field">
                    <span class="revision-field-icon">@RevisionIcons.Icon("pin")</span>
                    <span>
                        <span class="revision-field-label">Municipio de residencia</span>
                        <span class="revision-field-value @Clase(Model.Solicitante.MunicipioResidencia?.Nombre)">@Valor(Model.Solicitante.MunicipioResidencia?.Nombre)</span>
                    </span>
                </div>
                <div class="revision-field">
                    <span class="revision-field-icon">@RevisionIcons.Icon("home")</span>
                    <span>
                        <span class="revision-field-label">Dirección de domicilio</span>
                        <span class="revision-field-value @Clase(Model.Solicitante.DireccionDomicilio)">@Valor(Model.Solicitante.DireccionDomicilio)</span>
                    </span>
                </div>
                <div class="revision-field">
                    <span class="revision-field-icon">@RevisionIcons.Icon("person")</span>
                    <span>
                        <span class="revision-field-label">Grupo étnico</span>
                        <span class="revision-field-value">@Model.Solicitante.GrupoEtnico</span>
                    </span>
                </div>
            </div>
        </div>

        @await Html.PartialAsync("_RevisionComentarios", Model)
    </div>

    <div class="col-md-4">
        @await Html.PartialAsync("_RevisionDecisionPanel", Model)
    </div>
</div>
